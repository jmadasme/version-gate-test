[133.309, "o", "\u001b[90m┌─ cubecell_gui.py · probe_cubecell() ──────────────────────────────────────────────────────────────────\u001b[0m\n"]
[133.309, "o", "\u001b[90m 176\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mprobe_cubecell\u001b[39;49;00m(device, timeout=\u001b[94m1.2\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[133.364, "o", "\u001b[90m 177\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33mDetecta si `device` es el CubeCell (firmware LoRaWAN demo).\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[133.419, "o", "\u001b[90m 178\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[133.474, "o", "\u001b[90m 179\u001b[0m\u001b[90m │ \u001b[0m    Envía una línea no-HEX (\u001b[33m'\u001b[39;49;00m\u001b[33mx\u001b[39;49;00m\u001b[33m\\\\\u001b[39;49;00m\u001b[33mn\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m): el firmware responde\u001b[90m\u001b[39;49;00m\n"]
[133.529, "o", "\u001b[90m 180\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33m?? Error: escribe hex valido\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m + prompt. Es inofensivo (no genera\u001b[90m\u001b[39;49;00m\n"]
[133.584, "o", "\u001b[90m 181\u001b[0m\u001b[90m │ \u001b[0m    uplink LoRaWAN ni borra nada). Devuelve \u001b[94mTrue\u001b[39;49;00m/\u001b[94mFalse\u001b[39;49;00m.\u001b[90m\u001b[39;49;00m\n"]
[133.639, "o", "\u001b[90m 182\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[133.694, "o", "\u001b[90m 183\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[133.749, "o", "\u001b[90m 184\u001b[0m\u001b[90m │ \u001b[0m        s = serial.Serial(device, BAUD, timeout=timeout)\u001b[90m\u001b[39;49;00m\n"]
[133.804, "o", "\u001b[90m 185\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
