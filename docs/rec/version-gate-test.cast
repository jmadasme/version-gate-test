[37.902, "o", "\u001b[90m 105\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[96muint32_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00moff\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
[37.957, "o", "\u001b[90m 106\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mhal_flash_erase(SESSION_PARTITION,\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[94m4096\u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
