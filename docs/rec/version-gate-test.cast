[147.341, "o", "\u001b[90m┌─ cubecell_gui.py · send_uplink() ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[147.341, "o", "\u001b[90m 532\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92msend_uplink\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[147.396, "o", "\u001b[90m 533\u001b[0m\u001b[90m │ \u001b[0m        text = \u001b[96mself\u001b[39;49;00m.hex_input.text().strip()\u001b[90m\u001b[39;49;00m\n"]
[147.451, "o", "\u001b[90m 534\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m text:\u001b[90m\u001b[39;49;00m\n"]
[147.506, "o", "\u001b[90m 535\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mself\u001b[39;49;00m.append_log(\u001b[33m\"\u001b[39;49;00m\u001b[33m[GUI] Escribe datos antes de enviar.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, YELLOW)\u001b[90m\u001b[39;49;00m\n"]
[147.561, "o", "\u001b[90m 536\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[147.616, "o", "\u001b[90m 537\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.ascii_mode.isChecked():\u001b[90m\u001b[39;49;00m\n"]
[147.671, "o", "\u001b[90m 538\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[147.726, "o", "\u001b[90m 539\u001b[0m\u001b[90m │ \u001b[0m                raw = text.encode(\u001b[33m\"\u001b[39;49;00m\u001b[33mlatin-1\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[147.781, "o", "\u001b[90m 540\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mexcept\u001b[39;49;00m \u001b[96mUnicodeEncodeError\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[147.836, "o", "\u001b[90m 541\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m.append_log(\u001b[33m\"\u001b[39;49;00m\u001b[33m[GUI] Modo ASCII: solo caracteres 0–255.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, RED)\u001b[90m\u001b[39;49;00m\n"]
[147.891, "o", "\u001b[90m 542\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[147.946, "o", "\u001b[90m 543\u001b[0m\u001b[90m │ \u001b[0m            hex_str = \u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.join(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mb\u001b[33m:\u001b[39;49;00m\u001b[33m02X\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[94mfor\u001b[39;49;00m b \u001b[95min\u001b[39;49;00m raw)\u001b[90m\u001b[39;49;00m\n"]
[148.001, "o", "\u001b[90m 544\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[148.056, "o", "\u001b[90m 545\u001b[0m\u001b[90m │ \u001b[0m            cleaned = re.sub(\u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m[^0-9A-Fa-f]\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, text)\u001b[90m\u001b[39;49;00m\n"]
[148.111, "o", "\u001b[90m 546\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m cleaned \u001b[95mor\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(cleaned) % \u001b[94m2\u001b[39;49;00m != \u001b[94m0\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[148.166, "o", "\u001b[90m 547\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m.append_log(\u001b[90m\u001b[39;49;00m\n"]
[148.221, "o", "\u001b[90m 548\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[33m\"\u001b[39;49;00m\u001b[33m[GUI] HEX inválido. Usa pares de dígitos, ej: DE AD BE EF\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, RED)\u001b[90m\u001b[39;49;00m\n"]
[148.276, "o", "\u001b[90m 549\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[148.331, "o", "\u001b[90m 550\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[148.386, "o", "\u001b[90m 551\u001b[0m\u001b[90m │ \u001b[0m                raw = \u001b[96mbytes\u001b[39;49;00m.fromhex(cleaned)\u001b[90m\u001b[39;49;00m\n"]
[148.441, "o", "\u001b[90m 552\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mexcept\u001b[39;49;00m \u001b[96mValueError\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
